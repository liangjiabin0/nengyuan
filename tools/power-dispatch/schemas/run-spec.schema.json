{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/power-dispatch/run-spec.schema.json",
  "title": "Power Dispatch RunSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task",
    "case",
    "capabilities",
    "objective",
    "constraints",
    "solver",
    "outputs"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0", "1.1"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "single_period_operation",
            "time_series_dispatch",
            "hierarchical_coordination",
            "multi_timescale_coordination",
            "composed_task",
            "review_only"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": true,
      "required": ["case_id"],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source": {
          "type": "string"
        },
        "main_grid": {
          "type": "string"
        },
        "distribution": {
          "type": "string"
        },
        "microgrids": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "boundary_ports": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "time_scales", "power_control"],
      "properties": {
        "hierarchy": {
          "enum": [
            "single_grid",
            "transmission",
            "distribution",
            "microgrid",
            "transmission_distribution",
            "distribution_microgrid",
            "main_distribution_microgrid"
          ]
        },
        "time_scales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["single_period", "day_ahead", "intra_day", "real_time"]
          }
        },
        "power_control": {
          "enum": ["P", "Q", "PQ"]
        },
        "rolling_optimization": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "timeseries": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile_file": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "step_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "day_ahead": {
          "type": "object"
        },
        "intra_day": {
          "type": "object"
        },
        "real_time": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "objective": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "object"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "solver": {
      "type": "object",
      "additionalProperties": true,
      "required": ["backend"],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "solver_name": {
          "type": "string"
        },
        "time_limit_s": {
          "type": "number",
          "minimum": 0
        },
        "options": {
          "type": "object"
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "case": {
            "properties": {
              "case_id": {
                "enum": [
                  "ieee14",
                  "ieee30",
                  "ieee57",
                  "ieee118",
                  "case33bw",
                  "main_dist_micro_demo"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
