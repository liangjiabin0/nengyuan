LLM_API_KEY=
LLM_BASE_URL=http://10.1.4.166:8000/v1
LLM_MODEL=Arc
LLM_THINK=0
# 大模型（互联网）；未配置时使用设置页保存值或内置默认
LLM_LARGE_API_KEY=
LLM_LARGE_BASE_URL=https://api.openai.com/v1
LLM_LARGE_MODEL=gpt-4o
LLM_LARGE_THINK=0
# 对话接口格式：openai（/v1/chat/completions）或 anthropic（/v1/messages）。设置页可改。
LLM_API_FORMAT=openai
LLM_LARGE_API_FORMAT=openai
# 图像生成不要写环境变量。设置页「图像生成」会写入 storage/settings.json 的 image 段，便于同步到服务器。
# 本地 LLM Gateway（OpenCode 固定连此地址；真实上游由 settings.json 动态注入）
LLM_GATEWAY_PORT=4098
SEMANTIC_SEARCH=0
# 导师档案默认走内网 SearXNG；设 MENTOR_LOCAL_CORPUS=1 才恢复本地 mentors 语料导出/导入
SEARXNG_BASE_URL=http://10.1.4.166:8080
MENTOR_LOCAL_CORPUS=0
# 兼容旧部署：PACKY_API_KEY / PACKY_BASE_URL / PACKY_MODEL 仍可作为后备变量
# 主数据库已使用 PostgreSQL；密码需要 URL 编码。不要提交真实连接串。
DATABASE_URL=
PGPASSWORD=
PG_POOL_MAX=12
# 仅兼容旧脚本/测试数据路径，新部署不能用它替代 PostgreSQL。
DATABASE_PATH=storage/rag.sqlite
# 相对项目根；也可写成绝对路径
DATA_ROOT_DIR=数据
# 通过 localhost / 127.0.0.1 / ::1 打开时自动以 admin 登录；局域网 IP 仍需账号密码。
# OpenCode 工具令牌由 sidecar 自动生成，不要手工共享。
AI4ES_AGENT_API_TOKEN=
# 首次创建管理员前必须改为至少 12 位随机密码；已创建账户请在管理页修改。
DEFAULT_ADMIN_PASSWORD=
# 多能规划（openTEPES + Gurobi）。不要把 Gurobi 许可或 mapbox token 写进仓库。
MGPLAN_ROOT=
MGPLAN_PYTHON=
MGPLAN_CONFIG_DIR=
MGPLAN_OUTPUT_DIR=
MAPBOX_TOKEN=
# Gurobi 许可三选一：本机 gurobi.lic / GRB_LICENSE_FILE / WLS。不要提交真实值。
GRB_LICENSE_FILE=
WLSACCESSID=
WLSSECRET=
LICENSEID=
# 仅使用厂商 ISV 许可时填写；普通学术/商业/WLS 许可保持为空。
MGPLAN_GUROBI_ISV_NAME=
MGPLAN_GUROBI_ISV_APP=
MGPLAN_GUROBI_ISV_KEY=
MGPLAN_GUROBI_ISV_EXPIRATION=0
# 仅本机有 Gurobi 时才开启真实重算联调
RUN_MGPLAN_INTEGRATION_TESTS=0
# ESOPT（均相对项目根；运行时会自动解析为当前部署目录）
ESOPT_ROOT=tools/esopt
ESOPT_BRIDGE=tools/esopt/esopt_bridge
ESOPT_NATIVE_ROOT=tools/esopt
ESOPT_PYTHON=
# MCP 启动器固定使用项目内 scripts/esopt-mcp.cmd，无需填写绝对路径。
ESOPT_MCP_LAUNCHER=
# TDMG 交流 OPF（默认 tools/tdmg-acopf-dispatch，需 scripts/_vendor）
TDMG_ROOT=
TDMG_PYTHON=
# 电力系统优化调度 Skill
DISPATCH_ROOT=
DISPATCH_PYTHON=
# 南网理论线损
LOSS_ROOT=
LOSS_PYTHON=
# 光伏/风电/负荷预测
FORECAST_ROOT=
FORECAST_PYTHON=
# OpenModelica 仿真网关（默认 http://127.0.0.1:18088，避开常见 :8088 占用）
OPENMODELICA_GATEWAY_URL=
OPENMODELICA_OMC=
OMG_API_KEY=
OMG_PORT=18088
# OpenAlex 学术图谱（能元 openalex skill）。请配置你自己的 key，仓库不包含内置授权。
OPENALEX_API_KEY=
# 智能对话工作区与附件保留天数。到期删除附件和 storage/chat-workspaces 内容，只保留对话记录。
CHAT_WORKSPACE_RETENTION_DAYS=7
# 期刊追踪（/journal-watch）：worker 每天到点抓取订阅期刊新文章。设为 0 关闭。
JOURNAL_WATCH_ENABLED=1
# 每天几点（服务器本地时间，0-23）之后开始抓取
JOURNAL_WATCH_HOUR=3
# 第一次运行往前抓多少天
JOURNAL_WATCH_BACKFILL_DAYS=30
# 自动下载开放获取全文（IEEE 开放获取文章、arXiv 等公开版本）。设为 0 关闭；每次最多下载篇数
JOURNAL_WATCH_OA_DOWNLOAD=1
JOURNAL_WATCH_OA_MAX=40
# 可选：Crossref 礼貌访问用的联系邮箱
JOURNAL_WATCH_MAILTO=
# IEEE Xplore API（developer.ieee.org）：补 IEEE 期刊的摘要、关键词、完整作者
IEEE_XPLORE_API_KEY=
# Elsevier API（dev.elsevier.com）：目前只开通了基础检索，暂未用于抓取
ELSEVIER_API_KEY=
# 论文智能评审（/paper-review）专用模型端点。也可在“模型配置 → 论文智能评审”页面里填写（页面保存的优先）。
PAPER_REVIEW_BASE_URL=
PAPER_REVIEW_API_KEY=
PAPER_REVIEW_MODEL=gpt-6.1-sol
# 运行技能 Python 脚本与复现脚本用的解释器（绝对路径）；不填则自动查找
PAPER_REVIEW_PYTHON=
# 复现脚本线程数上限
PAPER_REVIEW_THREADS=4
# 可选：只给论文智能评审的模型请求使用的 HTTP 代理（服务商限制地区时用）
PAPER_REVIEW_PROXY=
