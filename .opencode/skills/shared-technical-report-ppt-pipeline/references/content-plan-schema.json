{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical report PPT content plan",
  "type": "object",
  "required": ["deck", "slides"],
  "properties": {
    "deck": {
      "type": "object",
      "required": ["title", "audience", "purpose", "template", "aspectRatio"],
      "properties": {
        "title": {"type": "string"},
        "audience": {"type": "string"},
        "purpose": {"type": "string"},
        "communicationJob": {"type": "string"},
        "template": {"type": "string"},
        "aspectRatio": {"const": "16:9"},
        "globalConstraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "title", "subtitle", "takeaway", "layout", "sourceSlide", "sourceRefs", "content", "visuals"],
        "properties": {
          "page": {"type": "integer", "minimum": 0},
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "takeaway": {"type": "string"},
          "layout": {"enum": ["cover", "technical-content", "case-analysis", "comparison", "formula-heavy"]},
          "sourceSlide": {"type": "integer", "enum": [1, 2, 3]},
          "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "content": {"type": "array", "items": {"type": "string"}},
          "visuals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "source", "purpose"],
              "properties": {
                "type": {"enum": ["report-figure", "native-chart", "native-diagram", "table", "generated-illustration", "formula"]},
                "source": {"type": "string"},
                "purpose": {"type": "string"},
                "placement": {"type": "string"}
              }
            }
          },
          "formulaIds": {"type": "array", "items": {"type": "string"}},
          "negativeConstraints": {"type": "array", "items": {"type": "string"}},
          "speakerNotesSources": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
