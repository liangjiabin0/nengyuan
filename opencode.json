  "tools": {
    "esopt_*": false
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": "deny",
    "task": "deny",
    "todowrite": "deny",
    "webfetch": "allow",
    "websearch": "deny",
    "web_search": "allow",
    "shared_skills": "allow",
    "save_learning_memory": "allow",
    "search_learning_memory": "allow",
    "skill": {
      "*": "allow",
      "chart-discovery": "deny"
    },
    "lsp": "deny",
    "mcp": {
      "*": "allow"
    },
    "doom_loop": "deny"
  },
  "mcp": {
    "esopt": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/d",
        "/c",
        "{env:ESOPT_MCP_LAUNCHER}"
      ],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "ESOPT_ROOT": "{env:ESOPT_ROOT}",
        "ESOPT_BRIDGE": "{env:ESOPT_BRIDGE}",
        "ESOPT_NATIVE_ROOT": "{env:ESOPT_NATIVE_ROOT}",
        "ESOPT_PYTHON": "{env:ESOPT_PYTHON}"
      }
    }
  }
