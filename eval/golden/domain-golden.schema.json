{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-golden.schema.json",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "intent", "mustContain", "mustTools", "forbiddenTools", "expectedSourceTypes", "expectedRefusal"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "intent": { "type": "string" },
          "mustContain": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "mustTools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "forbiddenTools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expectedSourceTypes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expectedRefusal": { "type": "boolean" },
          "maxToolCalls": { "type": "integer", "minimum": 0 },
          "maxLatencyMs": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
